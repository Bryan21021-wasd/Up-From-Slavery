start = book
book = element book {(author | dedication | chapList | chapter | p | text )+ }
author = element author {text}
dedication = element dedication {(text | person)+}
chapList = element chapList {text}
chapter = element chapter {(n | text | title | p | tone)+}
p = element p {(text | HistRef | place | inequality)+}
person = element person {relation, text}
HistRef = attribute HistRef {(person | event | text}
relation = attribute relation {text}
place = element place {(country | text | state)+}
country = attribute country {text}
title = element title {titleName, text}
titleName = attribute titleName {text}
n = attribute n {text}
tone = element tone {(feeling | text | place | year)+}
feeling = attribute feeling {text}
state = attribute state {text}
year = element year {n, text}

