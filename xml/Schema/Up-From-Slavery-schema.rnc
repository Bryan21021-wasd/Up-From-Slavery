start = book
book = element book {(author | dedication | chapList | chapter | p | text )+ }
author = element author {text}
dedication = element dedication {(text | person | place)+}
chapList = element chapList {text}
chapter = element chapter {(n | text | title | p | tone1 | tone2 | letter)+}
p = element p {(text | HistRef | place | project1 | project2 | tone1 | tone2 | person | period | description)+}
person = element person {relation, (text | place)+}
HistRef = element HistRef {(name | event | text)+}
relation = attribute relation {text}
place = element place {(country | state | school | city | region)+, text}
country = attribute country {text}
title = element title {titleName, text}
titleName = attribute titleName {text}
n = attribute n {text}
tone1 = element tone {(feeling | text | place | year | project1 | project2 | person | HistRef | place | description | period | tone2)+}
tone2 = element tone {(feeling | text | place | year | project1 | project2 | person | HistRef | place | description | period)+}
feeling = attribute feeling {text}
state = attribute state {text}
year = element year {n, text}
event = attribute event {text}
name = attribute name {text}
project1 = element project {(theme | text | person | place | HistRef | project2 | type)+}
project2 = element project {(theme | text | person | place | HistRef | type)+}
theme = attribute theme {text}
period = element period {time, (text | person | project1 | project2)+}
time = attribute time {text}
description = element description {(text | project1 | project2)+}
type = attribute type {text}
school = attribute school {text}
city = attribute city {text}
letter = element letter {p*}
region = attribute region {text}